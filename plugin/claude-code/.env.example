# Hook environment variables -- set automatically by Claude Code at runtime.
# Copy this file to .env for reference when running scripts manually.
#
# Usage: source .env && bash scripts/session-start.sh

# Absolute path to the open project in Claude Code
CLAUDE_PROJECT_DIR=/path/to/your/project

# Tool name passed to the PreToolUse hook (e.g. Bash, Read, Edit)
CLAUDE_TOOL_NAME=Bash

# JSON-encoded tool input passed to the PreToolUse hook
CLAUDE_TOOL_INPUT={}
